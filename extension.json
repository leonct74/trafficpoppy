{
  "id": "com.trafficpoppy.desktop",
  "name": "TrafficPoppy",
  "version": "0.2.6",
  "description": "Privacy-first web analytics that run entirely in your own AWS — a 1 KB script tag, no cookies, no banners, and nobody in the data path but you.",
  "icon": "frontend/trafficpoppy-icon.png",
  "bugsUrl": "https://github.com/leonct74/trafficpoppy/issues",
  "permissionSet": {
    "id": "trafficpoppy-backend",
    "name": "TrafficPoppy backend",
    "description": "Deploys and removes its own CloudFormation stack (named TrafficPoppyStack): a DynamoDB table, a collector Lambda behind a public URL, and a least-privilege execution role for that Lambda. Every change and delete is limited to resources named TrafficPoppy* (and a trafficpoppy-deploy-* code bucket) — it cannot touch anything else in your account. It creates one narrowly-scoped IAM role for its own Lambda; no account or organisation access.",
    "requiredTags": [
      "agentspoppy:account",
      "agentspoppy:app",
      "agentspoppy:connection"
    ],
    "grants": [
      {
        "service": "cloudformation",
        "actions": [
          "CreateStack",
          "UpdateStack",
          "ContinueUpdateRollback",
          "DeleteStack",
          "DescribeStacks",
          "DescribeStackEvents",
          "DescribeStackResources"
        ],
        "resourceScope": "arn:aws:cloudformation:*:*:stack/TrafficPoppy*"
      },
      {
        "service": "dynamodb",
        "actions": [
          "CreateTable",
          "DeleteTable",
          "DescribeTable",
          "UpdateTimeToLive",
          "DescribeTimeToLive",
          "TagResource",
          "ListTagsOfResource",
          "Query",
          "Scan",
          "GetItem",
          "PutItem",
          "UpdateItem",
          "DeleteItem"
        ],
        "resourceScope": "arn:aws:dynamodb:*:*:table/TrafficPoppy*"
      },
      {
        "service": "lambda",
        "actions": [
          "CreateFunction",
          "DeleteFunction",
          "GetFunction",
          "UpdateFunctionCode",
          "UpdateFunctionConfiguration",
          "CreateFunctionUrlConfig",
          "DeleteFunctionUrlConfig",
          "GetFunctionUrlConfig",
          "AddPermission",
          "RemovePermission",
          "GetPolicy",
          "TagResource",
          "ListTags"
        ],
        "resourceScope": "arn:aws:lambda:*:*:function:TrafficPoppy*"
      },
      {
        "service": "iam",
        "actions": [
          "CreateRole",
          "DeleteRole",
          "GetRole",
          "PassRole",
          "PutRolePolicy",
          "DeleteRolePolicy",
          "GetRolePolicy",
          "PutRolePermissionsBoundary",
          "DeleteRolePermissionsBoundary",
          "TagRole",
          "ListRoleTags"
        ],
        "resourceScope": "arn:aws:iam::*:role/TrafficPoppy*"
      },
      {
        "service": "logs",
        "actions": [
          "CreateLogGroup",
          "DeleteLogGroup",
          "PutRetentionPolicy",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "arn:aws:logs:*:*:log-group:/aws/lambda/TrafficPoppy*"
      },
      {
        "service": "s3",
        "actions": [
          "CreateBucket",
          "DeleteBucket",
          "ListBucket",
          "PutBucketTagging",
          "GetBucketLocation"
        ],
        "resourceScope": "arn:aws:s3:::trafficpoppy-deploy-*"
      },
      {
        "service": "s3",
        "actions": [
          "PutObject",
          "GetObject",
          "DeleteObject"
        ],
        "resourceScope": "arn:aws:s3:::trafficpoppy-deploy-*/*"
      },
      {
        "service": "acm",
        "actions": [
          "RequestCertificate",
          "DescribeCertificate",
          "DeleteCertificate",
          "AddTagsToCertificate",
          "ListTagsForCertificate"
        ],
        "resourceScope": "tagged-as-self"
      },
      {
        "service": "cloudfront",
        "actions": [
          "CreateDistribution",
          "CreateDistributionWithTags",
          "GetDistribution",
          "UpdateDistribution",
          "DeleteDistribution",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "tagged-as-self"
      },
      {
        "service": "cognito-idp",
        "actions": [
          "CreateUserPool",
          "DeleteUserPool",
          "UpdateUserPool",
          "DescribeUserPool",
          "DeleteUserPoolClient",
          "UpdateUserPoolClient",
          "DescribeUserPoolClient",
          "GetUserPoolMfaConfig",
          "AdminCreateUser",
          "AdminDeleteUser",
          "AdminSetUserPassword",
          "AdminAddUserToGroup",
          "AdminRemoveUserFromGroup",
          "AdminListGroupsForUser",
          "DeleteGroup",
          "ListUsers",
          "TagResource",
          "ListTagsForResource"
        ],
        "resourceScope": "tagged-as-self"
      },
      {
        "service": "cognito-idp",
        "actions": [
          "CreateUserPoolClient",
          "CreateGroup"
        ],
        "resourceScope": "arn:aws:cognito-idp:*:*:userpool/*",
        "reason": "Adds the app client and the group inside the sign-in directory TrafficPoppy created. Both are child resources whose AWS APIs accept no tags at all, and the parent directory's id is generated by AWS, so neither can be scoped narrower. Both are pure creates: this grant can add a child to a directory and can never read, change or delete anything."
      }
    ],
    "limits": null
  },
  "frontend": {
    "entry": "frontend/index.html"
  },
  "backend": {
    "entry": "backend/index.cjs",
    "transport": "http",
    "runtime": "node22",
    "isolation": "strict"
  },
  "teardown": {
    "endpoint": "/teardown"
  },
  "capabilities": [
    "aws:credentials",
    "connection:read",
    "backend:invoke",
    "commerce:purchase",
    "host:openExternal"
  ]
}
